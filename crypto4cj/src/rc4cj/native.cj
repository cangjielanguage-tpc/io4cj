foreign func malloc(size: UIntNative): CPointer<Unit>

/**
 * The class is RC4KEY
 * @author guo_tingtingtekla
 * @since 0.32.5
 */
public class RC4KEY {
    let rcptr: CPointer<RC4_KEY>

    /**
     * The Function is init constructor
     *
     * @since 0.32.5
     */
    public init() {
        /*
         * struct RC4_KEY: 
         * UInt32: 4 * 256 = 1024
         * Int32: 4 * 2 = 8
         * plus: 1032
         */
        var ptr = unsafe { malloc(1032) }
        var p = CPointer<RC4_KEY>(ptr)
        this.rcptr = p
    }
}