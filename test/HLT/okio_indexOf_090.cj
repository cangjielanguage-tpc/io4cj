import std.io.*
import std.time.*
import io4cj.*

@Test
public class okio_indexOf_090{

    @TestCase
    func okio_indexOf_090(): Unit {
        var exc = ""
        try {
            let arrb:Array<Byte> = [6,0,4,3,5,16,5]
            let a_buffer = Buffer()
            a_buffer.write(arrb)
            println(a_buffer.indexOf(0,8,7))
        } catch (e:Exception) {
            //e.printStackTrace()
            println("e.message = ${e.message}")
            exc=e.message
        }
        @Assert(exc.contains("fromIndex: 8 is greater than toIndex: 8 or less than 0"),true)
    }
    @TestCase
    func okio_indexOf_090_2(): Unit {
        var exc = ""
        try {
            let arrb:Array<Byte> = [6,0,4,3,5,16,5]
            let a_buffer = Buffer()
            a_buffer.write(arrb)
            let source: Source = a_buffer
            let bufferedSource: BufferedSource = Okio.buffer(source)
            println(bufferedSource.indexOf(0,8,7))
        } catch (e:Exception) {
            //e.printStackTrace()
            println("e.message = ${e.message}")
            exc=e.message
        }
        @Assert(exc.contains("fromIndex=8 toIndex=7"),true)
    }  
}